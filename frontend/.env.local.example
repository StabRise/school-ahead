# Copy to .env.local for local development.
# See docs/architecture/05-auth-flow.md and 06-frontend-architecture.md.

# No trailing /api — the Orval-generated client's paths already include it
# (Django Ninja bakes the mount prefix into the OpenAPI schema).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Used only by orval.config.ts at codegen time (bun run orval:generate).
OPENAPI_SCHEMA_URL=http://localhost:8000/api/openapi.json
