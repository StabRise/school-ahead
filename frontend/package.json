{
  "name": "school-ahead-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "orval:generate": "bun run --cwd packages/api-client orval:generate",
    "piper-voices:generate": "bun run --cwd packages/api-client piper-voices:generate"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
