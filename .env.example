# Copy to .env at the repo root and fill in real values for local development.
# See docs/architecture/05-auth-flow.md.

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://school_ahead:school_ahead@localhost:5432/school_ahead

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# The frontend's origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origin(s) Django's built-in CSRF middleware trusts for session-authenticated
# POSTs (the admin login form) — separate from CORS_ALLOWED_ORIGINS above,
# which only covers the custom JWT double-submit CSRF check. Needs the
# backend's own origin(s), comma-separated. Not needed for local dev over
# plain HTTP.
# CSRF_TRUSTED_ORIGINS=https://api-school.example.com

# Set to True only when running behind a reverse proxy that terminates TLS
# and always sets X-Forwarded-Proto itself (never pass through a
# client-supplied one) — without it, Django can't tell the request was
# HTTPS, which breaks CSRF_TRUSTED_ORIGINS matching above. Leave False for
# local dev and for any setup without such a proxy.
# DJANGO_BEHIND_TLS_PROXY=True

# Shared parent domain for auth cookies (must cover both frontend and backend
# origins so Next.js's server can read the same cookie — see
# docs/architecture/05-auth-flow.md). "localhost" works for local dev
# regardless of port.
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# File storage — "filesystem" (default) stores uploads under backend/media/.
# Set to "s3" to store them in S3 (or an S3-compatible service) instead; the
# vars below are only read when it's "s3". See core/settings.py.
DJANGO_STORAGE_BACKEND=filesystem
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only needed for a non-AWS S3-compatible provider (MinIO, Spaces, R2,
# Synology, ...).
# AWS_S3_ENDPOINT_URL=
# Only needed to serve files from a CDN/custom domain instead of the bucket.
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_QUERYSTRING_AUTH=False
# Most self-hosted S3-compatible servers (Synology, MinIO, ...) need "path"
# here — they don't have DNS/vhost routing for the default
# virtual-hosted-style addressing (bucket.endpoint/key), which otherwise
# fails with a 403 on HeadObject/PutObject. Leave unset for AWS itself.
# AWS_S3_ADDRESSING_STYLE=path
# Usually not needed — boto3 defaults to SigV4 already — but some
# self-hosted servers require it set explicitly.
# AWS_S3_SIGNATURE_VERSION=s3v4

# --- docker-compose.prod.yml only ---
# Pulls pre-built images instead of building locally — see
# .github/workflows/docker-build-push.yml, which pushes to this same
# registry/tag scheme. REGISTRY_USERNAME/REGISTRY_PASSWORD aren't read by
# docker-compose.prod.yml itself — Compose has no login mechanism of its
# own — they're used by `make prod-login` to `docker login` on this host
# before pulling, since forgejo.stabrise.com/mykola/school-ahead-* are
# private images. Same credentials as the GitHub Actions repo secrets of
# the same name that push them.
REGISTRY=forgejo.stabrise.com
REGISTRY_USERNAME=mykola
REGISTRY_PASSWORD=your-registry-password-or-token
IMAGE_TAG=latest

# Bearer token for watchtower's HTTP API (docker-compose.prod.yml's
# watchtower service, port 9002) — trigger a pull+restart of backend/frontend
# after CI pushes a new image with:
#   curl -H "Authorization: Bearer $WATCHTOWER_HTTP_API_TOKEN" http://<host>:9002/v1/update
WATCHTOWER_HTTP_API_TOKEN=change-me-to-a-random-secret

# Postgres credentials for docker-compose.prod.yml's postgres service —
# DATABASE_URL above is for connecting from the host (local dev); the prod
# compose file builds its own DATABASE_URL from these three plus the
# in-network "postgres" hostname, so keep them in sync.
POSTGRES_DB=school_ahead
POSTGRES_USER=school_ahead
POSTGRES_PASSWORD=change-me-to-a-random-secret

# Host-published port for docker-compose.prod.yml's postgres service (e.g.
# for psql/pgAdmin/backups from outside the Docker network) — change this if
# 5432 is already taken on the host, as it commonly is. This only affects
# the host-side mapping; backend always reaches postgres over the internal
# Docker network at its container-internal port (always 5432, unrelated to
# this), so no other value needs to change alongside it.
POSTGRES_PORT=5432

# --- docker-compose.prod.yml's db-backup service ---
# NOTE: this service currently references a "db" dependency that isn't
# defined anywhere in docker-compose.prod.yml (only "postgres" is) and loads
# its own credentials from .env.lago rather than this file — it looks like
# it was carried over from a different project rather than written for
# school-ahead, and won't start as-is. Vars listed here only because the
# compose file references them; double-check the service itself before
# relying on this backup running.
POSTGRES_HOST=postgres
POSTGRES_BACKUP_S3_BUCKET=your-backup-bucket
POSTGRES_BACKUP_S3_FOLDER=school_ahead-backups
POSTGRES_BACKUP_S3_ENDPOINT=
POSTGRES_BACKUP_S3_REGION=us-east-1
POSTGRES_BACKUP_AWS_ACCESS_KEY_ID=
POSTGRES_BACKUP_AWS_SECRET_ACCESS_KEY=
# Cron schedule (backup container's own syntax), how backups are compressed,
# whether to run one immediately on container start, whether the hostname is
# included in the backup filename, and how many days of backups to retain.
POSTGRES_BACKUP_SCHEDULE=0 2 * * *
POSTGRES_BACKUP_COMPRESSION=pigz
POSTGRES_BACKUP_RUN_ON_STARTUP=false
POSTGRES_BACKUP_INCLUDE_HOSTNAME=false
POSTGRES_BACKUP_KEEP_DAYS=30
